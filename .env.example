# Postgres connection strings. Locally, or with a provider that only gives
# you one connection string, set both to the same value.
#
# DATABASE_URL: the pooled connection the app uses at runtime (e.g.
#   Supabase's port-6543 "Transaction pooler" URL, or Neon's pooled URL).
# DIRECT_URL: the direct/unpooled connection used only for migrations
#   (e.g. Supabase's port-5432 URL, or Neon's unpooled URL).
DATABASE_URL="postgresql://user:password@localhost:5432/nfl_dfs"
DIRECT_URL="postgresql://user:password@localhost:5432/nfl_dfs"
